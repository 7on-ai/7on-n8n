      "parameters": {
        "jsCode": "const context = $input.first().json;\nconst userId = context.userId;\nif (!userId) return { json: { ...context, persona: { ...context.persona, tokens: {} } } };\nconst n8nUrl = process.env.N8N_BASE_URL || '';\nconst n8nEmail = process.env.N8N_USER_EMAIL || '';\nconst n8nPassword = process.env.N8N_USER_PASSWORD || '';\nif (!n8nUrl || !n8nEmail || !n8nPassword) return { json: { ...context, persona: { ...context.persona, tokens: {} } } };\ntry {\n  const loginRes = await fetch(`${n8nUrl}/rest/login`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ emailOrLdapLoginId: n8nEmail, password: n8nPassword }) });\n  if (!loginRes.ok) return { json: { ...context, persona: { ...context.persona, tokens: {} } } };\n  const cookies = loginRes.headers.get('set-cookie') || '';\n  const credsRes = await fetch(`${n8nUrl}/rest/credentials`, { headers: { Cookie: cookies } });\n  if (!credsRes.ok) return { json: { ...context, persona: { ...context.persona, tokens: {} } } };\n  const allCreds = await credsRes.json();\n  const userCreds = (allCreds.data || []).filter(c => c.name && c.name.startsWith(`${userId}:`));\n  const tokens = {}; const metadata = {};\n  for (const cred of userCreds) {\n    try {\n      const detailRes = await fetch(`${n8nUrl}/rest/credentials/${cred.id}`, { headers: { Cookie: cookies } });\n      if (!detailRes.ok) continue;\n      const detail = await detailRes.json();\n      const data = detail.data || {};\n      const service = cred.name.split(':')[1];\n      if (data.oauthTokenData) { const prefix = service === 'google' ? 'google' : service; tokens[`${prefix}_access_token`] = data.oauthTokenData.access_token; tokens[`${prefix}_refresh_token`] = data.oauthTokenData.refresh_token; }\n      if (service === 'openrouter' && data.apiKey) tokens.openrouter_access_token = data.apiKey;\n      if (service === 'line_notify' && data.value) tokens.line_notify_token = data.value.replace('Bearer ', '');\n      if (service === 'youtube_api' && data.apiKey) tokens.youtube_api_key = data.apiKey;\n      if (service === 'google_maps' && data.apiKey) tokens.google_maps_key = data.apiKey;\n      if (service === 'openweathermap' && data.accessToken) tokens.openweathermap_key = data.accessToken;\n      if (service === 'brave_search' && data.value) tokens.brave_api_key = data.value;\n      if (service === 'finnhub' && data.apiKey) tokens.finnhub_api_key = data.apiKey;\n      if (service === 'nutritionix') { tokens.nutritionix_app_id = data.value || ''; tokens.nutritionix_api_key = data.additionalHeaders?.['x-app-key'] || ''; }\n      if (service === 'fal_ai' && data.value) tokens.fal_api_key = data.value.replace('Key ', '');\n      if (service === 'elevenlabs' && data.apiKey) { tokens.elevenlabs_api_key = data.apiKey; try { const m = JSON.parse(detail.refreshToken || '{}'); if (m.voice_id) metadata.elevenlabs_voice_id = m.voice_id; } catch(e) {} }\n      if (service === 'unsplash' && data.value) tokens.unsplash_access_key = data.value.replace('Client-ID ', '');\n      if (service === 'lastfm') { tokens.lastfm_api_key = data.value || ''; try { const m = JSON.parse(detail.refreshToken || '{}'); if (m.username) metadata.lastfm_username = m.username; if (m.session_key) metadata.lastfm_session_key = m.session_key; } catch(e) {} }\n      if (service === 'home_assistant' && data.value) { tokens.ha_token = data.value.replace('Bearer ', ''); try { const m = JSON.parse(detail.refreshToken || '{}'); if (m.url) metadata.ha_url = m.url; } catch(e) {} }\n      if (service === 'sonos') { try { const m = JSON.parse(detail.refreshToken || '{}'); if (m.url) metadata.sonos_api_url = m.url; } catch(e) {} }\n    } catch (err) { console.log(`[Load Tokens] Error processing ${cred.name}:`, err.message); }\n  }\n  return { json: { ...context, persona: { ...context.persona, tokens: { ...tokens, ...metadata } } } };\n} catch (err) {\n  console.error('[Load Tokens] Error:', err.message);\n  return { json: { ...context, persona: { ...context.persona, tokens: {} } } };\n}"
      },
