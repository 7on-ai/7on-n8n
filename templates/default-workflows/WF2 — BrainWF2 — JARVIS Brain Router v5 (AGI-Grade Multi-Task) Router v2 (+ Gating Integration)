    {
      "parameters": {
        "jsCode": "// ═══════════════════════════════════════════════════════════════════════\n// JARVIS BRAIN ROUTER v4 — AGI-Grade Multi-Task Parallel Dispatch\n//\n// Architecture: Fan-Out / Scatter-Gather\n// - LLM decomposes message into structured intent array (JSON)\n// - Each intent maps to an agent with tailored sub-task\n// - Parallel dispatch via Promise.all (P1+P2)\n// - P3 = fire-and-forget async background tasks\n// - Single-intent = direct forward (no overhead)\n// - Response synthesis for multi-agent results\n//\n// Fallback chain:\n//   1. user OR key + claude-haiku-4-5\n//   2. 402/429 → user OR key + llama-3.3-70b:free\n//   3. no key → system OR key + llama-3.3-70b:free\n// ═══════════════════════════════════════════════════════════════════════\n\nconst payload  = $input.first().json;\nconst message  = payload.message || '';\nconst persona  = payload.persona || {};\nconst lang     = persona.language_preference || 'th';\nconst name     = persona.name || 'User';\nconst tier     = persona.subscriptionTier || 'FREE';\nconst stage    = persona.ethical_profile?.growth_stage || 2;\nconst stageLabel = persona.ethical_profile?.growth_stage_label || 'Developing';\nconst interests  = (persona.interests || []).slice(0, 5).join(', ') || 'not specified';\nconst keyFacts   = (persona.key_facts || []).slice(0, 3).join(' | ') || 'none';\nconst recentMemTypes = (persona.relevant_memories || []).map(m => m.type).join(', ') || 'none';\n\nconst PAID_MODEL = 'anthropic/claude-haiku-4-5';\nconst FREE_MODEL = 'meta-llama/llama-3.3-70b-instruct:free';\nconst userKey   = persona.tokens?.openrouter_access_token || '';\nconst systemKey = process.env.OPENROUTER_API_KEY || '';\n\nconst n8nBase = process.env.N8N_BASE_URL || 'http://localhost:5678';\nconst AGENT_URLS = {\n  wf3a: process.env.N8N_WF3A_URL || `${n8nBase}/webhook/wf3a-secretary`,\n  wf3b: process.env.N8N_WF3B_URL || `${n8nBase}/webhook/wf3b-soul`,\n  wf3c: process.env.N8N_WF3C_URL || `${n8nBase}/webhook/wf3c-careercoach`,\n  wf3d: process.env.N8N_WF3D_URL || `${n8nBase}/webhook/wf3d-explorer`,\n  wf3e: process.env.N8N_WF3E_URL || `${n8nBase}/webhook/wf3e-creator`,\n  wf3f: process.env.N8N_WF3F_URL || `${n8nBase}/webhook/wf3f-homemate`,\n  wf3g: process.env.N8N_WF3G_URL || `${n8nBase}/webhook/wf3g-healthcoach`\n};\n\n// ── SYSTEM PROMPT: Structured Intent Decomposition ──────────────────────\nconst SYSTEM_PROMPT = `You are JARVIS — the central cognitive router of an advanced personal AI system.\nYour function: Decompose the user's message into a structured dispatch plan.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nAGENT REGISTRY\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\nwf3a [SECRETARY] — External coordination & communication\n  • Calendar, reminders, alarms, countdowns, scheduling\n  • Email, LINE notify, Telegram, Discord, Slack, SMS\n  • Social media: post, DM, tweet, LinkedIn\n  • Task management: todo, checklist, Notion, Trello\n  • Trigger words: นัด/remind/ส่ง/post/reply/schedule/notify/check inbox\n\nwf3b [SOUL] — Inner world, emotions & personal growth\n  • Emotional processing: venting, sharing feelings, being heard\n  • Journaling: daily log, gratitude, mood entry, reflection\n  • Personal growth: habits, streaks, mindfulness, meditation\n  • Relationships: emotional angle (not logistics)\n  • Identity & meaning: purpose, values, self-discovery, existential\n  • Memory: recalling life events, past conversations\n  • Crisis: hopelessness, self-harm → ALWAYS wf3b, ALWAYS crisis=true\n  • Trigger signals: รู้สึก/เครียด/เศร้า/เหนื่อย/กังวล/เจ็บ/ท้อ/สับสน/อยากระบาย/บันทึก\n\nwf3c [CAREER COACH] — Finance, work & Thai professional context\n  • Personal finance: budget, expenses, savings, debt management\n  • Investment: stocks (SET/NYSE/crypto/forex/gold/funds)\n  • Career: job search, resume, salary, interview, promotion\n  • Thai legal/tax: labor law, income tax, VAT, business registration\n  • Business: invoice, quotation, ROI, P&L\n  • Trigger words: เงิน/ลงทุน/หุ้น/ภาษี/งาน/เงินเดือน/budget/resign/คำนวณ(เงิน)\n\nwf3d [EXPLORER] — Knowledge retrieval & real-world data\n  • Web search: news, research, Wikipedia, general facts\n  • Real-time: weather, traffic, exchange rates, sports scores\n  • Location: maps, directions, nearby places, travel info\n  • Developer: GitHub, npm, docs, Stack Overflow, API reference\n  • Factual Q&A about the external world\n  • Trigger words: ค้นหา/search/หาข้อมูล/อยากรู้เรื่อง/ข่าว/สภาพอากาศ/แผนที่\n\nwf3e [CREATOR] — Content generation & creative output\n  • AI image generation, visual design, thumbnails\n  • Text-to-speech, voice synthesis (ElevenLabs)\n  • Creative writing: stories, poems, scripts, blog posts\n  • Language services: translation (documents/creative), copywriting, proofreading\n  • Stock assets: Unsplash photos\n  • Trigger words: สร้าง/generate/วาด/แต่ง/เขียน/แปล(เอกสาร)/ออกแบบ/TTS\n\nwf3f [HOME MATE] — Ambient environment & entertainment\n  • Music: Spotify, Sonos, playlist, podcast, radio\n  • Smart home: Home Assistant, lights, AC, sensors, routines\n  • Ambient modes: focus, sleep, relaxation sounds\n  • Trigger words: เปิด/ปิด/เล่นเพลง/ไฟ/อุณหภูมิ/playlist/play music\n\nwf3g [HEALTH COACH] — Physical health & body optimization\n  • Nutrition: calorie tracking, meal logging, macros, food lookup\n  • Fitness: workout plans, exercise log, steps, heart rate\n  • Health metrics: BMI, TDEE, blood pressure, sleep\n  • Medical info: symptoms, medicine, dosage (non-emergency)\n  • Trigger words: กิน/อาหาร/แคล/ออกกำลังกาย/น้ำหนัก/BMI/ยา/อาการ\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nINTENT DECOMPOSITION RULES\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\nRULE 1 — SINGLE INTENT (most messages):\nIf message has one clear purpose → return array with 1 item, priority=1\n\nRULE 2 — MULTI-INTENT (compound messages):\nIf message has 2+ distinct, separable intents → return array with multiple items\nEach intent gets its own agent + tailored sub-task\nPriority 1 = primary (what user needs most right now)\nPriority 2 = secondary (enrichment, can run parallel)\nPriority 3 = background (fire-and-forget, user doesn't need to wait)\nMAX 3 intents. If more, consolidate into most important 3.\n\nRULE 3 — EMOTIONAL OVERLAY:\nIf emotion + clear task exist:\n  → Is there an explicit action verb (play/search/log/set/send/generate)?\n  → YES: task agent P1, optional wf3b P2 if emotion is significant\n  → NO: wf3b P1 (emotion IS the request)\n\nRULE 4 — COMPOUND EXAMPLES:\n\"เครียด + อยากฟังเพลง\" → [{wf3f, P1}, {wf3b, P2}]\n\"log อาหาร + เปิดเพลง\" → [{wf3g, P1}, {wf3f, P3}]\n\"check email + อากาศวันนี้\" → [{wf3a, P1}, {wf3d, P2}]\n\"เครียดมาก ไม่รู้จะทำยังไง\" → [{wf3b, P1}] (single intent)\n\"ลดน้ำหนัก + หาข้อมูล diet\" → [{wf3g, P1}, {wf3d, P2}]\n\"resign + คำนวณ severance\" → [{wf3c, P1}] (same domain, single agent)\n\"เครียดเรื่องเงิน\" → [{wf3b, P1}] (emotion only, no financial task)\n\"เครียดเรื่องเงิน ช่วยทำ budget\" → [{wf3c, P1}, {wf3b, P2}]\n\nRULE 5 — SUB-TASK TAILORING:\nFor each intent, write a focused sub_task that tells the agent exactly what to do.\nThis improves agent accuracy significantly.\nSub-task should be concise (1 sentence), in the same language as original message.\n\nRULE 6 — GATING (emotional depth for growth AI training):\ntrue = deep emotional disclosure, significant life events, sustained struggle, crisis\nfalse = commands, greetings, factual questions, surface emotional mentions\nApply per-intent (usually only wf3b intents have gating=true)\n\nRULE 7 — CRISIS DETECTION:\nIf ANY signal of crisis (hopelessness, self-harm, \"ไม่อยากมีชีวิต\", isolation, severe depression):\n→ Add crisis:true to the wf3b intent\n→ crisis overrides everything else\n\nRULE 8 — AMBIGUITY RESOLUTION:\nShort/unclear message with no strong domain signal → [{wf3b, P1, gating:false}]\nGreeting/acknowledgement → [{wf3b, P1, gating:false}]\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nOUTPUT FORMAT — STRICT JSON ONLY\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nReturn ONLY valid JSON. No explanation. No markdown. No backticks.\n\n{\n  \"intents\": [\n    {\n      \"agent\": \"wf3x\",\n      \"priority\": 1,\n      \"sub_task\": \"<focused instruction for this agent in user's language>\",\n      \"gating\": false,\n      \"crisis\": false\n    }\n  ]\n}\n\nRules for JSON output:\n- \"agent\": one of wf3a/wf3b/wf3c/wf3d/wf3e/wf3f/wf3g\n- \"priority\": 1 (primary), 2 (secondary parallel), 3 (background async)\n- \"sub_task\": tailored instruction for that specific agent (user's language)\n- \"gating\": boolean — emotional depth threshold\n- \"crisis\": boolean — only true for genuine crisis signals\n- Array ordered by priority ascending\n- Never duplicate the same agent twice\n- Never return more than 3 intents\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nCONTEXT (use to disambiguate edge cases)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nUser: ${name}\nLanguage: ${lang}\nTier: ${tier}\nGrowth stage: ${stage}/5 (${stageLabel})\nInterests: ${interests}\nKey facts: ${keyFacts}\nRecent memory themes: ${recentMemTypes}`;\n\n// ── Helper: call OpenRouter ─────────────────────────────────────────────\nasync function callRouter(apiKey, model) {\n  return fetch('https://openrouter.ai/api/v1/chat/completions', {\n    method: 'POST',\n    headers: {\n      'Authorization': `Bearer ${apiKey}`,\n      'Content-Type': 'application/json',\n      'HTTP-Referer': 'https://7on.ai',\n      'X-Title': '7on JARVIS Router'\n    },\n    body: JSON.stringify({\n      model,\n      max_tokens: 300,\n      temperature: 0,\n      response_format: { type: 'json_object' },\n      messages: [\n        { role: 'system', content: SYSTEM_PROMPT },\n        { role: 'user', content: message }\n      ]\n    })\n  });\n}\n\n// ── Helper: parse and validate JSON output ──────────────────────────────\nfunction parseIntents(text) {\n  const VALID = ['wf3a','wf3b','wf3c','wf3d','wf3e','wf3f','wf3g'];\n  try {\n    const clean = (text || '').replace(/```json|```/g, '').trim();\n    const parsed = JSON.parse(clean);\n    const intents = parsed.intents || parsed; // handle both {intents:[]} and []\n    const arr = Array.isArray(intents) ? intents : [intents];\n    // Validate and sanitize each intent\n    const validated = arr\n      .filter(i => i && VALID.includes(i.agent))\n      .map(i => ({\n        agent: i.agent,\n        priority: [1,2,3].includes(i.priority) ? i.priority : 1,\n        sub_task: i.sub_task || message,\n        gating: i.gating === true,\n        crisis: i.crisis === true\n      }))\n      .sort((a, b) => a.priority - b.priority)\n      .slice(0, 3);\n    // Deduplicate agents\n    const seen = new Set();\n    const deduped = validated.filter(i => { if (seen.has(i.agent)) return false; seen.add(i.agent); return true; });\n    if (deduped.length === 0) throw new Error('No valid intents');\n    return deduped;\n  } catch (e) {\n    console.log('[Router] Parse failed, fallback:', e.message);\n    return [{ agent: 'wf3b', priority: 1, sub_task: message, gating: false, crisis: false }];\n  }\n}\n\n// ── Fallback chain ──────────────────────────────────────────────────────\nlet rawText = null;\nlet usedModel = null;\nlet usedKeyType = null;\n\nif (userKey) {\n  try {\n    const res = await callRouter(userKey, PAID_MODEL);\n    if (res.ok) {\n      const d = await res.json();\n      rawText = d.choices?.[0]?.message?.content || null;\n      usedModel = PAID_MODEL; usedKeyType = 'user_paid';\n      console.log('[Router] ✅ user key + paid model');\n    } else if (res.status === 402 || res.status === 429) {\n      console.log(`[Router] ${res.status} → trying user key + free model`);\n      const res2 = await callRouter(userKey, FREE_MODEL);\n      if (res2.ok) {\n        const d2 = await res2.json();\n        rawText = d2.choices?.[0]?.message?.content || null;\n        usedModel = FREE_MODEL; usedKeyType = 'user_free';\n        console.log('[Router] ✅ user key + free model');\n      }\n    } else {\n      console.log(`[Router] user key error ${res.status}`);\n    }\n  } catch (e) { console.log('[Router] user key exception:', e.message); }\n}\n\nif (!rawText && systemKey) {\n  try {\n    const res3 = await callRouter(systemKey, FREE_MODEL);\n    if (res3.ok) {\n      const d3 = await res3.json();\n      rawText = d3.choices?.[0]?.message?.content || null;\n      usedModel = FREE_MODEL; usedKeyType = 'system_free';\n      console.log('[Router] ✅ system key + free model');\n    }\n  } catch (e) { console.log('[Router] system key exception:', e.message); }\n}\n\nconst intents = parseIntents(rawText);\nconst primaryIntent = intents[0];\nconst hasCrisis = intents.some(i => i.crisis);\n\nconsole.log(`[Router] Dispatching ${intents.length} intent(s) | model=${usedModel} | key=${usedKeyType}`);\nintents.forEach(i => console.log(`  → ${i.agent} P${i.priority} | gating=${i.gating} | crisis=${i.crisis} | task: ${i.sub_task.slice(0,60)}...`));\n\n// ── Emit gating for any intent that needs it (async, non-blocking) ──────\nconst gatingIntents = intents.filter(i => i.gating || i.crisis);\nif (gatingIntents.length > 0) {\n  const gatingUrl = `${n8nBase}/webhook/wf5b-gating-queue`;\n  const dbUrl = process.env.DATABASE_URL || '';\n  const openrouterKey = persona.tokens?.openrouter_access_token || '';\n  if (dbUrl) {\n    gatingIntents.forEach(intent => {\n      const gatingPayload = {\n        user_id: payload.userId,\n        text: message,\n        crisis: intent.crisis || false,\n        database_url: dbUrl,\n        metadata: {\n          session_id: payload.sessionId,\n          source: intent.agent,\n          language: lang,\n          timestamp: payload.timestamp || new Date().toISOString(),\n          openrouter_key: openrouterKey\n        }\n      };\n      fetch(gatingUrl, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(gatingPayload) })\n        .then(r => console.log(`[Gating] ✅ Queued ${intent.agent} crisis=${intent.crisis} status=${r.status}`))\n        .catch(e => console.log('[Gating] ⚠️ Failed (non-blocking):', e.message));\n    });\n  }\n}\n\n// ── Build dispatch plan ─────────────────────────────────────────────────\n// Separate by priority: P1+P2 dispatch in parallel, P3 async background\nconst foregroundIntents = intents.filter(i => i.priority <= 2);\nconst backgroundIntents = intents.filter(i => i.priority === 3);\n\n// Fire P3 background tasks async (fire-and-forget)\nbackgroundIntents.forEach(intent => {\n  const agentPayload = {\n    ...payload,\n    message: intent.sub_task,\n    originalMessage: message,\n    targetAgent: intent.agent,\n    targetUrl: AGENT_URLS[intent.agent],\n    isBackground: true,\n    routerVersion: 'v4'\n  };\n  fetch(AGENT_URLS[intent.agent], { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(agentPayload) })\n    .then(r => console.log(`[Router] ✅ Background ${intent.agent} fired status=${r.status}`))\n    .catch(e => console.log(`[Router] ⚠️ Background ${intent.agent} failed:`, e.message));\n});\n\n// ── Dispatch foreground intents (P1 and P2 in parallel) ─────────────────\nif (foregroundIntents.length === 1) {\n  // Single agent — direct forward (no overhead)\n  const intent = foregroundIntents[0];\n  return {\n    json: {\n      ...payload,\n      message: intent.sub_task,\n      originalMessage: message,\n      targetAgent: intent.agent,\n      targetUrl: AGENT_URLS[intent.agent],\n      needsGating: intent.gating,\n      hasCrisis,\n      _intents: intents,\n      _dispatch_mode: 'single',\n      _router_model: usedModel,\n      _router_key_type: usedKeyType,\n      _router_version: 'v4'\n    }\n  };\n}\n\n// Multi-agent parallel dispatch\nconst dispatchResults = await Promise.allSettled(\n  foregroundIntents.map(async (intent) => {\n    const agentPayload = {\n      ...payload,\n      message: intent.sub_task,\n      originalMessage: message,\n      targetAgent: intent.agent,\n      targetUrl: AGENT_URLS[intent.agent],\n      needsGating: intent.gating,\n      hasCrisis: intent.crisis,\n      _dispatch_mode: 'multi_parallel',\n      _router_version: 'v4'\n    };\n    const res = await fetch(AGENT_URLS[intent.agent], {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify(agentPayload),\n      signal: AbortSignal.timeout(28000)\n    });\n    if (!res.ok) throw new Error(`${intent.agent} returned ${res.status}`);\n    const data = await res.json();\n    return { agent: intent.agent, priority: intent.priority, response: data };\n  })\n);\n\n// Extract responses\nconst agentResponses = dispatchResults\n  .filter(r => r.status === 'fulfilled')\n  .map(r => r.value)\n  .sort((a, b) => a.priority - b.priority);\n\nconst failedAgents = dispatchResults\n  .filter(r => r.status === 'rejected')\n  .map((r, i) => ({ agent: foregroundIntents[i]?.agent, reason: r.reason?.message }));\n\nif (failedAgents.length > 0) {\n  console.log('[Router] Some agents failed:', JSON.stringify(failedAgents));\n}\n\n// Primary response = P1 agent\nconst primaryResponse = agentResponses.find(r => r.priority === 1);\nconst secondaryResponses = agentResponses.filter(r => r.priority > 1);\n\n// Extract message text from response (handle various agent response formats)\nfunction extractMessage(responseData) {\n  return responseData?.message || responseData?.response || responseData?.output ||\n         responseData?.agentOutput || responseData?.text ||\n         (typeof responseData === 'string' ? responseData : null);\n}\n\nconst primaryMessage = primaryResponse ? extractMessage(primaryResponse.response) : null;\nconst supplementalMessages = secondaryResponses\n  .map(r => extractMessage(r.response))\n  .filter(Boolean);\n\n// Build synthesized response\nconst synthesizedMessage = primaryMessage ||\n  supplementalMessages[0] ||\n  'ได้รับคำสั่งแล้วครับ';\n\nconsole.log(`[Router] Multi-dispatch complete | success=${agentResponses.length} | failed=${failedAgents.length}`);\n\n// Return in same format as single-agent (route.ts compatibility)\nreturn {\n  json: {\n    message: synthesizedMessage,\n    response: synthesizedMessage,\n    output: synthesizedMessage,\n    _primary_agent: primaryIntent.agent,\n    _intents: intents,\n    _agent_responses: agentResponses.map(r => ({ agent: r.agent, priority: r.priority, message: extractMessage(r.response) })),\n    _dispatch_mode: 'multi_parallel',\n    _failed_agents: failedAgents,\n    _router_model: usedModel,\n    _router_key_type: usedKeyType,\n    _router_version: 'v4',\n    hasCrisis,\n    userId: payload.userId,\n    sessionId: payload.sessionId\n  }\n};"
