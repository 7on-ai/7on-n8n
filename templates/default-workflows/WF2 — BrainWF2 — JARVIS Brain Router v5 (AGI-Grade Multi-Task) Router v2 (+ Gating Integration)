    {
      "parameters": {
        "jsCode": "const userId = $input.first().json.userId;\nif (!userId) return { json: { error: 'No userId provided' } };\nconst dbUrl = process.env.DATABASE_URL || '';\nif (!dbUrl) {\n  return { json: { ...$input.first().json, persona: { userId, language_preference: 'th', tokens: {} } } };\n}\nfunction getTopStrengths(profile) {\n  const scores = { self_awareness: profile.self_awareness, emotional_regulation: profile.emotional_regulation, compassion: profile.compassion, integrity: profile.integrity, growth_mindset: profile.growth_mindset, wisdom: profile.wisdom, transcendence: profile.transcendence };\n  return Object.entries(scores).filter(([, v]) => v != null).sort(([, a], [, b]) => b - a).slice(0, 2).map(([k]) => k);\n}\ntry {\n  const { Pool } = require('pg');\n  const pool = new Pool({ connectionString: dbUrl });\n  const userResult = await pool.query(`SELECT id, name, email, language_preference, timezone, \"subscriptionTier\", persona, updated_at FROM \"User\" WHERE id = $1 LIMIT 1`, [userId]);\n  if (userResult.rows.length === 0) { await pool.end(); return { json: { ...$input.first().json, persona: { userId, language_preference: 'th', tokens: {} } } }; }\n  const user = userResult.rows[0];\n  let personaData = {};\n  try { const raw = user.persona; personaData = typeof raw === 'string' ? JSON.parse(raw) : (raw || {}); } catch (e) { personaData = {}; }\n  let ethicalProfile = null;\n  try {\n    const ethResult = await pool.query(`SELECT self_awareness, emotional_regulation, compassion, integrity, growth_mindset, wisdom, transcendence, growth_stage, total_interactions FROM user_data_schema.ethical_profiles WHERE user_id = $1 LIMIT 1`, [userId]);\n    if (ethResult.rows.length > 0) {\n      const ep = ethResult.rows[0];\n      ethicalProfile = { growth_stage: ep.growth_stage || 2, growth_stage_label: ['', 'Beginner', 'Developing', 'Growing', 'Advanced', 'Wise'][ep.growth_stage || 2], top_strengths: getTopStrengths(ep), total_interactions: ep.total_interactions || 0, last_routing: personaData.ethical_summary?.last_routing || null };\n    }\n  } catch (e) { console.log('[Load Context] ethical_profiles skip:', e.message); }\n  let keyFacts = [];\n  try { const factsResult = await pool.query(`SELECT fact FROM user_data_schema.memory_facts WHERE user_id = $1 ORDER BY created_at DESC LIMIT 10`, [userId]); keyFacts = factsResult.rows.map(r => r.fact); } catch (e) {}\n  let relevantMemories = [];\n  try {\n    const memoriesResult = await pool.query(`SELECT text, classification, reflection_prompt, created_at FROM user_data_schema.interaction_memories WHERE user_id = $1 AND classification IN ('growth_memory', 'wisdom_moment', 'challenge_memory') ORDER BY created_at DESC LIMIT 3`, [userId]);\n    relevantMemories = memoriesResult.rows.map(r => ({ summary: (r.text || '').slice(0, 120) + (r.text?.length > 120 ? '...' : ''), type: r.classification, insight: r.reflection_prompt || null, date: r.created_at }));\n  } catch (e) {}\n  await pool.end();\n  const persona = { userId: user.id, email: user.email, name: user.name || user.email?.split('@')[0], language_preference: user.language_preference || 'th', timezone: user.timezone || 'Asia/Bangkok', subscriptionTier: user.subscriptionTier || 'FREE', interests: personaData.interests || [], preferences: personaData.preferences || {}, physical_stats: personaData.physical_stats || {}, personality_notes: personaData.personality_notes || null, key_facts: keyFacts, ethical_profile: ethicalProfile, relevant_memories: relevantMemories, _persona_updated: personaData._last_memory_update || null, tokens: {} };\n  return { json: { ...$input.first().json, persona } };\n} catch (err) {\n  console.error('[Load Context] Database error:', err.message);\n  return { json: { ...$input.first().json, persona: { userId, language_preference: 'th', tokens: {}, _error: err.message } } };\n}"
