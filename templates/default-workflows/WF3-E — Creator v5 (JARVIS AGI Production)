        "name": "search_memories",
        "description": "Search past conversations and memories semantically. Use for: past creative projects, style preferences mentioned before, previous images or content created.",
        "jsCode": "const input = JSON.parse($input.first().json.query || '{}');\nconst query = input.query || input.q || '';\nconst limit = input.limit || 3;\nconst ctx    = $('Load Credentials').first().json;\nconst creds  = ctx.credentials || {};\nconst i18n   = ctx.i18n || {};\nconst userId = ctx.userId;\nconst dbUrl  = creds.database_url || process.env.DATABASE_URL || '';\nconst persona = ctx._persona || ctx.persona || {};\nconst tokens  = persona.tokens || {};\nconst embedKey = tokens.openrouter_access_token || process.env.OPENROUTER_API_KEY || '';\n\nif (!dbUrl)   return { json: { error: `Database ${i18n.not_connected||'not connected'}`, memories: [] } };\nif (!query || query.length < 3) return { json: { error: i18n.query_required || 'Query too short', memories: [] } };\nif (!embedKey) return { json: { error: 'OpenRouter key not configured', memories: [] } };\n\ntry {\n  const embedRes = await fetch('https://openrouter.ai/api/v1/embeddings', {\n    method: 'POST',\n    headers: { 'Authorization': `Bearer ${embedKey}`, 'Content-Type': 'application/json' },\n    body: JSON.stringify({ model: 'openai/text-embedding-3-small', input: query })\n  });\n  if (!embedRes.ok) return { json: { error: `Embed failed: ${embedRes.status}`, memories: [] } };\n  const embedData = await embedRes.json();\n  const embedding = embedData.data?.[0]?.embedding;\n  if (!embedding) return { json: { error: 'No embedding returned', memories: [] } };\n\n  const { Pool } = require('pg');\n  const pool = new Pool({ connectionString: dbUrl });\n  const vectorStr = `[${embedding.join(',')}]`;\n  const result = await pool.query(\n    `SELECT content, metadata, created_at,\n            1 - (embedding <=> $1::vector) AS similarity\n     FROM user_data_schema.memory_embeddings\n     WHERE user_id = $2 AND embedding IS NOT NULL\n       AND 1 - (embedding <=> $1::vector) > 0.6\n     ORDER BY embedding <=> $1::vector LIMIT $3`,\n    [vectorStr, userId, limit]\n  );\n  await pool.end();\n  const memories = result.rows.map(r => ({\n    content: r.content,\n    similarity: parseFloat(r.similarity.toFixed(3)),\n    metadata: r.metadata || {},\n    date: new Date(r.created_at).toLocaleDateString('th-TH')\n  }));\n  if (memories.length === 0) return { json: { message: 'No relevant memories found', memories: [], query } };\n  return { json: { memories, count: memories.length, query } };\n} catch(err) {\n  return { json: { error: `${i18n.error||'Error'}: ${err.message}`, memories: [] } };\n}"
