    {
      "parameters": {
        "name": "text_to_speech",
        "description": "Convert text to speech using ElevenLabs multilingual v2. Requires: text (max 2500 chars). Optional: voice_id, stability (0-1), similarity_boost (0-1). Returns both audio_base64 and audioDataUrl.",
        "jsCode": "const input = JSON.parse($input.first().json.query || '{}');\nconst ctx   = $('Load Credentials').first().json;\nconst creds = ctx.credentials || {};\nconst i18n  = ctx.i18n || {};\n\nif (!input.text) return { json: { error: i18n.text_required || 'text required' } };\n\nconst elKey   = creds.elevenlabs_api_key || process.env.ELEVENLABS_API_KEY || '';\nif (!elKey) return { json: { error: `ElevenLabs ${i18n.not_connected}`, help: i18n.configure } };\n\n// v3: check persona voice first, then input override, then default\nconst voiceId = input.voice_id || creds.elevenlabs_voice_id || 'pNInz6obpgDQGcFmaJgB';\nconst text    = input.text.slice(0, 2500);\n\ntry {\n  const res = await fetch(`https://api.elevenlabs.io/v1/text-to-speech/${voiceId}`, {\n    method: 'POST',\n    headers: {\n      'xi-api-key': elKey,\n      'Content-Type': 'application/json',\n      'Accept': 'audio/mpeg'\n    },\n    body: JSON.stringify({\n      text,\n      model_id: 'eleven_multilingual_v2',\n      voice_settings: {\n        stability:        parseFloat(input.stability || 0.5),\n        similarity_boost: parseFloat(input.similarity_boost || 0.75)\n      }\n    })\n  });\n  if (!res.ok) {\n    const err = await res.json().catch(() => ({}));\n    return { json: { error: err.detail?.message || `ElevenLabs HTTP ${res.status}` } };\n  }\n  const buffer = await res.arrayBuffer();\n  // v3: audio_base64 (raw Base64)  +  v4: audioDataUrl (data URI) — both for max compatibility\n  const audio_base64 = btoa(String.fromCharCode(...new Uint8Array(buffer)));\n  const audioDataUrl = `data:audio/mpeg;base64,${audio_base64}`;\n  return { json: {\n    success:       true,\n    message:       i18n.success || 'Audio generated',\n    audio_base64,\n    audioDataUrl,\n    format:        'mp3',\n    mimeType:      'audio/mpeg',\n    text_length:   text.length,\n    voice_id:      voiceId\n  }};\n} catch(e) {\n  return { json: { error: `${i18n.error||'Error'}: ${e.message}` } };\n}"
      },
