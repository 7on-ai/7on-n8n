n${userContextParts.join('\\n')}\\n`\n  : '';\n\n// ── GROWTH_GUIDANCE ───────────────────────────────────────────\nconst stage = p.ethical_profile?.growth_stage || 2;\nconst GROWTH_GUIDANCE = {\n  1: 'User is new to creative tools — explain what is possible, give examples, keep outputs simple',\n  2: 'User is developing — offer options and variations, show creative possibilities',\n  3: 'User is growing — explore their aesthetic, refine prompts together, discuss style',\n  4: 'User is advanced — peer-level creative discussion, push stylistic boundaries',\n  5: 'User is expert — focus on craft, subtlety, and distinctive creative voice'\n}[stage] || '';\n\nconst connected = Object.entries(creds).filter(([k,v]) => v).map(([k]) => k);\n\nconsole.log('[Load Credentials v5 Creator]', {\n  userId: prev.userId?.substring(0,8)+'...',\n  connected: connected.length,\n  lang,\n  hasUserKey: !!userOrKey,\n  growthStage: stage\n});\n\nreturn {\n  json: {\n    ...prev,\n    credentials: creds,\n    lang, i18n,\n    USER_CONTEXT,\n    GROWTH_GUIDANCE,\n    stage,\n    userOrKey, sysOrKey,\n    PAID_MODEL, FREE_MODEL,\n    _connected: connected,\n    _persona: p\n  }\n};"
      },
