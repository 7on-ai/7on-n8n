    {
      "parameters": {
        "name": "generate_image",
        "description": "Generate AI image using fal.ai FLUX. Requires: prompt (MUST be in English — translate first if needed). Optional: aspect_ratio (square|landscape|portrait, default square), style (photorealistic|artistic|anime, default photorealistic).",
        "jsCode": "const input = JSON.parse($input.first().json.query || '{}');\nconst ctx   = $('Load Credentials').first().json;\nconst creds = ctx.credentials || {};\nconst i18n  = ctx.i18n || {};\n\nif (!input.prompt) return { json: { error: i18n.prompt_required || 'prompt required (in English)', note: i18n.image_prompt_note } };\n\nconst falKey = creds.fal_api_key || process.env.FAL_API_KEY || '';\nif (!falKey) return { json: { error: `fal.ai API key ${i18n.not_connected}`, help: i18n.configure } };\n\n// v3 aspect_ratio named map (more intuitive than raw WxH)\nconst imageSizeMap = {\n  square:    'square_hd',\n  landscape: 'landscape_4_3',\n  portrait:  'portrait_4_3'\n};\nconst imageSize = imageSizeMap[input.aspect_ratio] || 'square_hd';\n\n// v3 style prompts — richer enhancement\nconst stylePrompts = {\n  photorealistic: 'photorealistic, high quality, 8k, detailed, sharp focus',\n  artistic:       'artistic, painterly, expressive, colorful, gallery quality',\n  anime:          'anime style, manga art, clean lines, vibrant colors'\n};\nconst styleAdd  = stylePrompts[input.style] || stylePrompts.photorealistic;\nconst fullPrompt = `${input.prompt}, ${styleAdd}`;\n\ntry {\n  const submitRes = await fetch('https://queue.fal.run/fal-ai/flux/schnell', {\n    method: 'POST',\n    headers: { 'Authorization': `Key ${falKey}`, 'Content-Type': 'application/json' },\n    body: JSON.stringify({\n      prompt: fullPrompt,\n      image_size: imageSize,\n      num_images: 1,\n      num_inference_steps: 4\n    })\n  });\n  if (!submitRes.ok) {\n    const err = await submitRes.json().catch(() => ({}));\n    return { json: { error: err.detail || `fal.ai submit failed: ${submitRes.status}` } };\n  }\n  const job = await submitRes.json();\n  const requestId = job.request_id;\n  if (!requestId) return { json: { error: 'No request_id from fal.ai' } };\n\n  // Poll max 30s (15 × 2s)\n  for (let i = 0; i < 15; i++) {\n    await new Promise(r => setTimeout(r, 2000));\n    const pollRes = await fetch(\n      `https://queue.fal.run/fal-ai/flux/schnell/requests/${requestId}`,\n      { headers: { 'Authorization': `Key ${falKey}` } }\n    );\n    const result = await pollRes.json();\n    if (result.status === 'COMPLETED' && result.response?.images?.[0]) {\n      const img = result.response.images[0];\n      return { json: {\n        success:         true,\n        message:         i18n.success || 'Image generated',\n        image_url:       img.url,\n        prompt:          fullPrompt,\n        original_prompt: input.prompt,\n        style:           input.style || 'photorealistic',\n        aspect_ratio:    input.aspect_ratio || 'square',\n        width:           img.width,\n        height:          img.height\n      }};\n    }\n    if (result.status === 'FAILED') return { json: { error: 'Image generation failed', detail: result.error } };\n  }\n  return { json: { error: 'Timeout waiting for image generation (30s)', requestId } };\n} catch(e) {\n  return { json: { error: `${i18n.error||'Error'}: ${e.message}` } };\n}"
      },
