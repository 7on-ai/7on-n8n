        "jsCode": "const input = JSON.parse($input.first().json.query || '{}');\nconst ctx    = $('Load Credentials').first().json;\nconst creds  = ctx.credentials || {};\nconst i18n   = ctx.i18n || {};\nconst userId = ctx.userId;\nconst dbUrl  = creds.database_url || process.env.DATABASE_URL || '';\nconst action = (input.action || 'insights').toLowerCase();\n\nif (!dbUrl) return { json: { error: i18n.db_not_configured || 'Database not configured' } };\n\nconst { Pool } = require('pg');\nconst pool = new Pool({ connectionString: dbUrl });\ntry {\n  if (action === 'log_interaction') {\n    const person  = input.person || '';\n    const type    = input.type || 'conversation';\n    const feeling = input.feeling || '';\n    const note    = input.note || '';\n    await pool.query(\n      `INSERT INTO user_data_schema.relationship_logs (user_id, person_name, interaction_type, feeling, note, created_at)\n       VALUES ($1, $2, $3, $4, $5, NOW())`,\n      [userId, person, type, feeling, note]\n    );\n    await pool.end();\n    return { json: { success: true, message: `Interaction with ${person} logged` } };\n  } else if (action === 'patterns') {\n    const result = await pool.query(\n      `SELECT person_name, COUNT(*) as interactions,\n              array_agg(DISTINCT interaction_type) as types\n       FROM user_data_schema.relationship_logs WHERE user_id = $1\n       AND created_at >= NOW() - INTERVAL '30 days'\n       GROUP BY person_name ORDER BY interactions DESC LIMIT 10`,\n      [userId]\n    );\n    await pool.end();\n    return { json: { patterns: result.rows, period: '30 days' } };\n  } else {\n    await pool.end();\n    return { json: {\n      message: 'Describe the situation and I will help reflect on patterns and perspectives.',\n      tip: 'Log interactions over time with log_interaction for pattern analysis'\n    }};\n  }\n} catch(err) {\n  try { await pool.end(); } catch(e) {}\n  return { json: { error: `${i18n.error||'Error'}: ${err.message}` } };\n}"
