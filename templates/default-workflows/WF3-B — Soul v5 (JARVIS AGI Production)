        "jsCode": "const input = JSON.parse($input.first().json.query || '{}');\nconst ctx    = $('Load Credentials').first().json;\nconst creds  = ctx.credentials || {};\nconst i18n   = ctx.i18n || {};\nconst userId = ctx.userId;\nconst dbUrl  = creds.database_url || process.env.DATABASE_URL || '';\nconst action = (input.action || 'read_profile').toLowerCase();\n\nif (!dbUrl) return { json: { error: i18n.db_not_configured || 'Database not configured' } };\n\nconst { Pool } = require('pg');\nconst pool = new Pool({ connectionString: dbUrl });\ntry {\n  if (action === 'read_profile') {\n    const result = await pool.query(\n      `SELECT display_name, language_preference, timezone, preferences, physical_stats\n       FROM user_data_schema.user_profiles WHERE user_id = $1 LIMIT 1`,\n      [userId]\n    );\n    await pool.end();\n    return { json: { profile: result.rows[0] || {}, found: result.rows.length > 0 } };\n  } else if (action === 'update_profile') {\n    const updates = input.updates || {};\n    if (Object.keys(updates).length === 0) return { json: { error: i18n.no_updates || 'No updates provided' } };\n    const result = await pool.query(\n      `UPDATE user_data_schema.user_profiles\n       SET preferences = COALESCE(preferences,'{}')::jsonb || $1::jsonb, updated_at = NOW()\n       WHERE user_id = $2 RETURNING user_id, preferences`,\n      [JSON.stringify(updates), userId]\n    );\n    await pool.end();\n    return { json: { success: true, message: i18n.success, updated: result.rows[0]?.preferences || {} } };\n  }\n  await pool.end();\n  return { json: { error: 'Unknown action. Use: read_profile | update_profile' } };\n} catch(err) {\n  try { await pool.end(); } catch(e) {}\n  return { json: { error: `${i18n.error||'Error'}: ${err.message}` } };\n}"
