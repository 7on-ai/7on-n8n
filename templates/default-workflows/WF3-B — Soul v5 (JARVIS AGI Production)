    {
      "parameters": {
        "name": "journal_entry",
        "description": "Create, read, or search journal/diary entries. Use for: writing thoughts, logging emotions, recording daily events. Actions: write (requires: content; optional: mood, tags[]), read (optional: limit), search (requires: keyword).",
        "jsCode": "const input = JSON.parse($input.first().json.query || '{}');\nconst action = (input.action || 'write').toLowerCase();\nconst ctx    = $('Load Credentials').first().json;\nconst creds  = ctx.credentials || {};\nconst i18n   = ctx.i18n || {};\nconst userId = ctx.userId;\nconst dbUrl  = creds.database_url || process.env.DATABASE_URL || '';\n\nif (!dbUrl) return { json: { error: i18n.db_not_configured || 'Database not configured' } };\n\nconst { Pool } = require('pg');\nconst pool = new Pool({ connectionString: dbUrl });\ntry {\n  if (action === 'write') {\n    const content = input.content || input.text || '';\n    const mood    = input.mood || null;\n    const tags    = input.tags || [];\n    if (!content) return { json: { error: 'Content required' } };\n    await pool.query(\n      `INSERT INTO user_data_schema.journal_entries (user_id, content, mood, tags, created_at)\n       VALUES ($1, $2, $3, $4, NOW())`,\n      [userId, content, mood, tags]\n    );\n    await pool.end();\n    return { json: { success: true, message: i18n.success || 'Journal entry saved', mood, tagsCount: tags.length } };\n  } else if (action === 'read') {\n    const limit = input.limit || 5;\n    const result = await pool.query(\n      `SELECT id, content, mood, tags, created_at FROM user_data_schema.journal_entries\n       WHERE user_id = $1 ORDER BY created_at DESC LIMIT $2`,\n      [userId, limit]\n    );\n    await pool.end();\n    return { json: { entries: result.rows, count: result.rows.length } };\n  } else if (action === 'search') {\n    const keyword = input.keyword || '';\n    const result  = await pool.query(\n      `SELECT id, content, mood, tags, created_at FROM user_data_schema.journal_entries\n       WHERE user_id = $1 AND content ILIKE $2 ORDER BY created_at DESC LIMIT 10`,\n      [userId, `%${keyword}%`]\n    );\n    await pool.end();\n    return { json: { entries: result.rows, count: result.rows.length, keyword } };\n  }\n  await pool.end();\n  return { json: { error: 'Unknown action. Use: write | read | search' } };\n} catch(err) {\n  try { await pool.end(); } catch(e) {}\n  return { json: { error: `${i18n.error||'Error'}: ${err.message}` } };\n}"
      },
