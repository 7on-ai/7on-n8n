        "description": "Log or view mood/emotion data over time. Use for: tracking emotional patterns, daily check-ins, mood history. Actions: log (requires: mood, score 1-10; optional: energy, note), history (optional: days), summary.",
        "jsCode": "const input = JSON.parse($input.first().json.query || '{}');\nconst action = (input.action || 'log').toLowerCase();\nconst ctx    = $('Load Credentials').first().json;\nconst creds  = ctx.credentials || {};\nconst i18n   = ctx.i18n || {};\nconst userId = ctx.userId;\nconst dbUrl  = creds.database_url || process.env.DATABASE_URL || '';\n\nif (!dbUrl) return { json: { error: i18n.db_not_configured || 'Database not configured' } };\n\nconst { Pool } = require('pg');\nconst pool = new Pool({ connectionString: dbUrl });\ntry {\n  if (action === 'log') {\n    const mood   = input.mood || 'neutral';\n    const score  = input.score ?? 5;\n    const note   = input.note || '';\n    const energy = input.energy ?? null;\n    await pool.query(\n      `INSERT INTO user_data_schema.mood_logs (user_id, mood, score, energy, note, created_at)\n       VALUES ($1, $2, $3, $4, $5, NOW())`,\n      [userId, mood, score, energy, note]\n    );\n    await pool.end();\n    return { json: { success: true, mood, score, energy, message: `Mood logged: ${mood} (${score}/10)` } };\n  } else if (action === 'history') {\n    const days = input.days || 7;\n    const result = await pool.query(\n      `SELECT mood, score, energy, note, created_at FROM user_data_schema.mood_logs\n       WHERE user_id = $1 AND created_at >= NOW() - INTERVAL '${days} days'\n       ORDER BY created_at DESC`,\n      [userId]\n    );\n    await pool.end();\n    return { json: { logs: result.rows, count: result.rows.length, days } };\n  } else if (action === 'summary') {\n    const result = await pool.query(\n      `SELECT mood, COUNT(*) as freq, AVG(score)::NUMERIC(3,1) as avg_score\n       FROM user_data_schema.mood_logs WHERE user_id = $1\n       AND created_at >= NOW() - INTERVAL '30 days'\n       GROUP BY mood ORDER BY freq DESC`,\n      [userId]\n    );\n    await pool.end();\n    return { json: { summary: result.rows, period: '30 days' } };\n  }\n  await pool.end();\n  return { json: { error: 'Unknown action. Use: log | history | summary' } };\n} catch(err) {\n  try { await pool.end(); } catch(e) {}\n  return { json: { error: `${i18n.error||'Error'}: ${err.message}` } };\n}"
      },
