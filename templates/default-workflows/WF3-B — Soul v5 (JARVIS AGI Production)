        "jsCode": "const input = JSON.parse($input.first().json.query || '{}');\nconst action = (input.action || 'reflect').toLowerCase();\nconst ctx    = $('Load Credentials').first().json;\nconst creds  = ctx.credentials || {};\nconst i18n   = ctx.i18n || {};\nconst userId = ctx.userId;\nconst dbUrl  = creds.database_url || process.env.DATABASE_URL || '';\nconst persona = ctx._persona || {};\nconst ethicalProfile = persona.ethical_profile || {};\n\nif (!dbUrl) return { json: { error: i18n.db_not_configured || 'Database not configured' } };\n\nconst { Pool } = require('pg');\nconst pool = new Pool({ connectionString: dbUrl });\ntry {\n  if (action === 'set_goal') {\n    const goal       = input.goal || '';\n    const category   = input.category || 'personal';\n    const targetDate = input.target_date || null;\n    if (!goal) return { json: { error: 'Goal description required' } };\n    await pool.query(\n      `INSERT INTO user_data_schema.growth_goals (user_id, goal, category, target_date, status, created_at)\n       VALUES ($1, $2, $3, $4, 'active', NOW())`,\n      [userId, goal, category, targetDate]\n    );\n    await pool.end();\n    return { json: { success: true, goal, category, message: `Goal set: \"${goal}\"` } };\n  } else if (action === 'review_goals') {\n    const result = await pool.query(\n      `SELECT id, goal, category, target_date, status, progress_note, created_at\n       FROM user_data_schema.growth_goals WHERE user_id = $1 AND status = 'active'\n       ORDER BY created_at DESC`,\n      [userId]\n    );\n    await pool.end();\n    return { json: { goals: result.rows, count: result.rows.length } };\n  } else if (action === 'values') {\n    await pool.end();\n    return { json: {\n      growth_stage:        ethicalProfile.growth_stage || 'exploring',\n      growth_stage_label:  ethicalProfile.growth_stage_label || '',\n      top_strengths:       ethicalProfile.top_strengths || [],\n      core_values:         ethicalProfile.core_values || [],\n      communication_style: ethicalProfile.communication_style || 'balanced',\n      life_priorities:     ethicalProfile.life_priorities || [],\n      message: 'Ethical profile retrieved from persona'\n    }};\n  } else {\n    // reflect: return prompt based on growth stage\n    const stage = ethicalProfile.growth_stage || 2;\n    const prompts = {\n      1: 'อะไรที่ทำให้คุณรู้สึกมีชีวิตชีวาในช่วงนี้?',\n      2: 'คุณสังเกตเห็นรูปแบบอะไรในการตอบสนองต่อความท้าทายของตัวเองไหม?',\n      3: 'การกระทำของคุณสอดคล้องกับสิ่งที่คุณให้คุณค่าแค่ไหน?',\n      4: 'คุณกำลังช่วยใครเติบโต และคุณเรียนรู้อะไรจากพวกเขา?',\n      5: 'มรดกที่คุณอยากฝากไว้คืออะไร?'\n    };\n    await pool.end();\n    return { json: { growth_stage: stage, reflection_prompt: prompts[stage] || prompts[2] } };\n  }\n} catch(err) {\n  try { await pool.end(); } catch(e) {}\n  return { json: { error: `${i18n.error||'Error'}: ${err.message}` } };\n}"
