        "description": "Log a completed habit or view habit streaks. Actions: log_habit (requires: habit_name; optional: completed bool, notes), view_streaks (returns habits with streak counts for last 30 days).",
        "jsCode": "const input = JSON.parse($input.first().json.query || '{}');\nconst ctx    = $('Load Credentials').first().json;\nconst creds  = ctx.credentials || {};\nconst i18n   = ctx.i18n || {};\nconst userId = ctx.userId;\nconst dbUrl  = creds.database_url || process.env.DATABASE_URL || '';\nconst action = (input.action || 'view_streaks').toLowerCase();\n\nif (!dbUrl) return { json: { error: i18n.db_not_configured || 'Database not configured' } };\n\nconst { Pool } = require('pg');\nconst pool = new Pool({ connectionString: dbUrl });\ntry {\n  if (action === 'log_habit') {\n    const name      = input.habit_name || '';\n    const completed = input.completed !== false;\n    const notes     = input.notes || '';\n    if (!name) return { json: { error: i18n.habit_name_required || 'habit_name is required' } };\n    const result = await pool.query(\n      `INSERT INTO user_data_schema.habit_log (user_id, habit_name, completed, notes, logged_at)\n       VALUES ($1, $2, $3, $4, NOW()) RETURNING id`,\n      [userId, name, completed, notes]\n    );\n    await pool.end();\n    return { json: { success: true, message: i18n.success, habit: name, completed, id: result.rows[0]?.id } };\n  } else {\n    // view_streaks\n    const result = await pool.query(\n      `SELECT habit_name, COUNT(*) as streak, MAX(logged_at) as last_done\n       FROM user_data_schema.habit_log\n       WHERE user_id = $1 AND logged_at >= NOW() - INTERVAL '30 days' AND completed = true\n       GROUP BY habit_name ORDER BY streak DESC`,\n      [userId]\n    );\n    await pool.end();\n    return { json: { habits: result.rows, count: result.rows.length } };\n  }\n} catch(err) {\n  try { await pool.end(); } catch(e) {}\n  return { json: { error: `${i18n.error||'Error'}: ${err.message}` } };\n}"
